{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ConfigRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::tfm-config-ckm-ew1",
        "arn:aws:s3:::tfm-config-ckm-ew1/*"
      ]
    },
    {
      "Sid": "S3TelecomRawRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::tfm-telecom-ckm-ew1",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/raw/*"
      ]
    },
    {
      "Sid": "S3TelecomWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject","s3:PutObject","s3:DeleteObject","s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::tfm-telecom-ckm-ew1",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/processed/*",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/processed_$folder$",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/ml_input/*",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/ml_input_$folder$",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/ml/*",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/ml_$folder$",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/quality/*",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/quality_$folder$",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/tmp/*",
        "arn:aws:s3:::tfm-telecom-ckm-ew1/tmp_$folder$"
      ]
    },
    {
      "Sid": "GlueCatalogWrite",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase","glue:GetTable","glue:GetTables",
        "glue:CreateTable","glue:UpdateTable",
        "glue:GetPartitions","glue:BatchCreatePartition"
      ],
      "Resource": [
        "arn:aws:glue:eu-west-1:<ACCOUNT_ID>:catalog",
        "arn:aws:glue:eu-west-1:<ACCOUNT_ID>:database/telecom_db",
        "arn:aws:glue:eu-west-1:<ACCOUNT_ID>:table/telecom_db/*"
      ]
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],
      "Resource": "arn:aws:logs:eu-west-1:<ACCOUNT_ID>:log-group:/aws-glue/*"
    }
  ]
}
